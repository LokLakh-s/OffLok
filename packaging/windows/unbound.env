# NLnet Labs' Unbound for Windows, shipped in OffLok's installer: pinned, its checksum checked at every build
# (https://nlnetlabs.nl/downloads/unbound/, unbound-<version>.zip and its .sha256). A new Unbound means a new OffLok:
# unbound-update.sh pins it once NLnet Labs' signature checks out, in .github/workflows/unbound.yml's pull request.
UNBOUND_VERSION=1.26.2
UNBOUND_SHA256=1274c4798ee418601b422e2c8112503844b4644f4bad73e6a691da8c9d1bc0d6
