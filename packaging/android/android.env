# The Android app's build tools, pinned (checked on 2026-11-01; NDK r29). The app builds for Android 9 (API 28,
# where the Private DNS state can be read) and later.
ANDROID_MIN_API=28
ANDROID_TARGET_API=36
ANDROID_BUILD_TOOLS=36.0.0
NDK_VERSION=29.0.14206865
NDK_ABIS="arm64-v8a armeabi-v7a x86_64"
# The release key's certificate (SHA-256), which signs the app for GitHub, F-Droid and Google Play (created
# 2026-11-01; the key is the release environment's secret, a copy is kept offline).
ANDROID_CERT_SHA256=795fecc414ed164c45d85142a541d4dc58ca4fe411f22b5d610730dab7cd3212
