# The Android app's build tools, pinned (checked on 2026-11-01; NDK r29). The app builds for Android 9 (API 28,
# where the Private DNS state can be read) and later.
ANDROID_MIN_API=28
ANDROID_TARGET_API=36
ANDROID_BUILD_TOOLS=36.0.0
NDK_VERSION=29.0.14206865
NDK_ABIS="arm64-v8a armeabi-v7a x86_64"
