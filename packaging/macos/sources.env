# What the macOS package builds Unbound from: NLnet Labs' source and OpenSSL 3.5 (its long-term support release,
# until 2030-04-08), each pinned with its SHA-256. Both signatures were checked when pinned (2026-10-30): Unbound's
# with NLnet Labs' release key G2 (packaging/windows/nlnetlabs-releases-g2.asc), OpenSSL's with OpenSSL's
# (packaging/macos/openssl-release.asc, B146 647E 45A7 B339 47AB 226B 2A2C 87D1 6169 2D40).
UNBOUND_VERSION=1.26.2
UNBOUND_SHA256=d8ee7aa6bbb3ff1be7d9e57637d0d0ec2f18273a8efff1a0afe2c665858b96f7
OPENSSL_VERSION=3.5.9
