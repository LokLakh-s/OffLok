<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OffLok @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="org.loklakh.offlok"/>
    </choices-outline>
    <choice id="org.loklakh.offlok" visible="false" title="OffLok">
        <pkg-ref id="org.loklakh.offlok"/>
    </choice>
    <pkg-ref id="org.loklakh.offlok" version="@VERSION@" onConclusion="none">offlok-component.pkg</pkg-ref>
</installer-gui-script>
